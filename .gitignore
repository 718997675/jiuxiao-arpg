# macOS
.DS_Store

# WorkBuddy 会话数据与应用标记文件
.workbuddy/
.workbuddy-ai/
.wbapp_*.genie

# 本地截图与调试产物（体积大，不纳入版本管理）
shots/
dev/shot-*.png
dev/*-smoke.png
dev/*.log

# 一次性探针脚本（查完就删，长期有用的都进 dev/）
.probe/

# 音频素材的生成源与试听产物：运行时用的是 audio/**/*.wav|m4a（已入库），
# wav-src 是 MIDI + 未压缩波形（29M），_meta 是试听图与报告，都只服务生成工具链。
audio/bgm/wav-src/
audio/sfx/_meta/

# 发布产物：由源码同步生成（cp index.html + src/ 到 dist/），不手工维护
dist/
jiuxiao-static.zip

# 依赖
node_modules/

# 日志
*.log
npm-debug.log*
